# Copy this file to .env (same folder) and fill in the values.
# .env is never committed to git. Restart the app after editing it.

# ── AI (reads the pasted sheet text) ─────────────────────────
# Using a third-party gateway? Fill all three from your gateway's dashboard.
# Works with gateways that speak the Anthropic format (/v1/messages) or the
# OpenAI format (/v1/chat/completions, e.g. OpenRouter-style "anthropic/claude-..." model names).
APQMS_AI_BASE_URL=
APQMS_AI_API_KEY=
APQMS_AI_MODEL=
# auto = if the gateway rejects a newer field, send a basic request (recommended)
# on   = always send the basic request      off = never
APQMS_AI_COMPAT=auto
# auto = Anthropic format first, OpenAI format if the gateway has no /v1/messages
# anthropic | openai = force one (openai skips the wasted first request)
APQMS_AI_PROTOCOL=auto

# Using Anthropic directly instead? Leave the three above empty and set:
# ANTHROPIC_API_KEY=sk-ant-...

# ── Telegram bot ─────────────────────────────────────────────
# Bot token from @BotFather
APQMS_TELEGRAM_BOT_TOKEN=
# Any long random text, letters and numbers only
APQMS_TELEGRAM_WEBHOOK_SECRET=
# Your Telegram chat id(s), comma separated. The bot tells you yours when you first message it.
APQMS_TELEGRAM_ALLOWED_CHATS=
# App username that quotations are created as
APQMS_TELEGRAM_USER=admin
# Hosting blocks api.telegram.org ("Network is unreachable")? Use a relay
# (tools/telegram_relay/README.md). Leave both empty to talk to Telegram directly.
APQMS_TELEGRAM_API_URL=
APQMS_TELEGRAM_RELAY_KEY=
